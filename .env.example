# Run immediately with no cloud credentials.
VITE_DATA_MODE=mock
# To use the backend: VITE_DATA_MODE=convex
VITE_CONVEX_URL=
# Permanent public origin, e.g. https://welist.example
VITE_PUBLIC_URL=
# Convex server variables (set with `npx convex env set`, never expose in VITE_):
# SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET, SPOTIFY_REQUESTS_PER_MINUTE,
# GUEST_SESSIONS_PER_MINUTE (refill rate, default 1000),
# GUEST_SESSION_BURST_CAPACITY (defaults to refill rate),
# GUEST_SESSION_LIMIT_SHARDS (default 64, maximum 256), JWT_PRIVATE_KEY, JWKS, SITE_URL
